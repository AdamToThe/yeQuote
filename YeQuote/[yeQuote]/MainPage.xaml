<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="_yeQuote_.MainPage"
             BackgroundColor="#F68148"
             >

    <Grid>

        <VerticalStackLayout
        Spacing="0"
        
        HorizontalOptions="CenterAndExpand"
        VerticalOptions="CenterAndExpand">

        <Label 
            x:Name="NiceAtPingPong"
            
            Text="i'm nice at ping pong"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center"
            
            TextColor="Black"
            FontSize="{OnPlatform Default=18,
                                  Android=18,
                                  iOS=18,
                                  WinUI=18}" 
            FontFamily="CarvingSoft"
            LineBreakMode="WordWrap"
            
            VerticalOptions="CenterAndExpand"
            HorizontalOptions="CenterAndExpand"
            
            MinimumHeightRequest="50"
            
            
            />

        <Label 
            x:Name="YeSignature"
            
            Text="[Kanye West]"
            TextColor="Black"
            FontFamily="CarvingSoft"
            HorizontalOptions="End"
            
            CharacterSpacing="2.7"
             
            />

        




    </VerticalStackLayout>

        <VerticalStackLayout
            VerticalOptions="End">
            
            <Label 
                x:Name="Extra"
    
                Text="Can't connect to the world, please turn on the wifi."
                TextColor="Black"
                FontFamily="CarvingSoft"
                HorizontalOptions="CenterAndExpand"
                VerticalOptions="EndAndExpand"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"
    
                MaximumWidthRequest="100"
                Padding="10"
    
                Margin="0"
                FontSize="10"
    
                IsVisible="False"
     
                />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
